# ─────────────────────────────────────────────────────────────
# Superfan — environment configuration
# Copy to .env.local and fill in what you have. Everything not
# configured is feature-flagged off or replaced by a mock adapter.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Demo mode — seeds/uses the fictional artist "Luma Vale" and enables the
# development-only "Generate Demo Event" menu. Never enable in production.
SUPERFAN_DEMO_MODE=true

# Secret used to sign claim / check-in / referral tokens and the local dev
# session cookie. Generate with: openssl rand -hex 32
SUPERFAN_SIGNING_SECRET=

# Key used to encrypt provider OAuth tokens at rest (32 bytes, hex).
# Generate with: openssl rand -hex 32
SUPERFAN_ENCRYPTION_KEY=

# ─── Database ────────────────────────────────────────────────
# Postgres connection string. For Supabase use the "Connection string"
# from Project Settings → Database (Transaction pooler, port 6543, or the
# direct connection on 5432 for migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/superfan

# ─── Supabase (auth + storage) ───────────────────────────────
# When NEXT_PUBLIC_SUPABASE_URL is empty the app falls back to the local
# development auth provider (magic links are printed to the server console).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Superfan <hello@superfan.app>

# ─── Meta / Instagram ────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ─── Shopify ─────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# ─── Spotify (experimental) ──────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── TikTok (experimental) ───────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Ticketmaster (Discovery API only) ───────────────────────
TICKETMASTER_API_KEY=
